    <dc:identifier>JSON_LD</dc:identifier>
    <dcterms:dateSubmitted rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2015-04-22</dcterms:dateSubmitted>
    <skos:altLabel xml:lang="en">JavaScript Object Notation for Linked Data</skos:altLabel>
    <skos:definition xml:lang="en">JSON-LD is a JSON-based format to serialize Linked Data. It is primarily intended to be a way to use Linked Data in Web-based programming environments, to build interoperable Web services, and to store Linked Data in JSON-based storage engines.</skos:definition>
    <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#IANA_MT">application/ld+json</skos:notation>
    <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#FILE_EXT">.jsonld</skos:notation>
    <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/file-type" />
