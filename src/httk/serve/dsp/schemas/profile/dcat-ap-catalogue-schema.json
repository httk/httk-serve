{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.httk.org/dsp/2025-1/dcat-ap-catalogue.json",
  "title": "httk strict DCAT-AP catalogue projection",
  "type": "object",
  "additionalProperties": false,
  "required": ["@context", "@id", "@type", "title", "description", "dct:publisher", "dcat:dataset", "dcat:service"],
  "properties": {
    "@context": {"type": "object"},
    "@id": {"$ref": "#/$defs/iri"},
    "@type": {"const": "Catalog"},
    "title": {"$ref": "#/$defs/text"},
    "description": {"$ref": "#/$defs/text"},
    "dct:publisher": {"$ref": "#/$defs/publisher"},
    "dcat:dataset": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/dataset"}},
    "dcat:service": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/service"}}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "iri": {"type": "string", "format": "uri"},
    "iriObject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["@id"],
      "properties": {"@id": {"$ref": "#/$defs/iri"}, "@type": {"type": "string"}}
    },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["@id", "@type", "foaf:name"],
      "properties": {
        "@id": {"$ref": "#/$defs/iri"},
        "@type": {"const": "Agent"},
        "foaf:name": {"$ref": "#/$defs/text"}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["@id", "@type", "permission"],
      "properties": {
        "@id": {"$ref": "#/$defs/iri"},
        "@type": {"const": "Offer"},
        "permission": {
          "type": "array", "minItems": 1, "maxItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["action"], "properties": {"action": {"const": "use"}}
          }
        }
      }
    },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["@id", "@type", "format", "mediaType", "accessURL", "downloadURL", "accessService"],
      "properties": {
        "@id": {"$ref": "#/$defs/iri"},
        "@type": {"const": "Distribution"},
        "format": {
          "type": "object",
          "additionalProperties": false,
          "required": ["@id", "@type"],
          "properties": {
            "@id": {"$ref": "#/$defs/iri"},
            "@type": {"const": "dct:MediaTypeOrExtent"}
          }
        },
        "mediaType": {"$ref": "#/$defs/iriObject"},
        "accessURL": {"$ref": "#/$defs/iriObject"},
        "downloadURL": {"$ref": "#/$defs/iriObject"},
        "byteSize": {"type": "integer", "minimum": 0},
        "checksum": {
          "type": "object",
          "additionalProperties": false,
          "required": ["@type", "algorithm", "checksumValue"],
          "properties": {
            "@type": {"const": "spdx:Checksum"},
            "algorithm": {
              "type": "object",
              "additionalProperties": false,
              "required": ["@id", "@type"],
              "properties": {
                "@id": {"const": "https://spdx.org/rdf/terms#checksumAlgorithm_sha256"},
                "@type": {"const": "spdx:ChecksumAlgorithm"}
              }
            },
            "checksumValue": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        "accessService": {"$ref": "#/$defs/iriObject"}
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["@id", "@type", "title", "description", "dct:publisher", "odrl:hasPolicy", "dcat:distribution"],
      "properties": {
        "@id": {"$ref": "#/$defs/iri"},
        "@type": {"const": "Dataset"},
        "title": {"$ref": "#/$defs/text"},
        "description": {"$ref": "#/$defs/text"},
        "dct:publisher": {"$ref": "#/$defs/iriObject"},
        "odrl:hasPolicy": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/policy"}},
        "dcat:distribution": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/distribution"}}
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["@id", "@type", "title", "endpointURL"],
      "properties": {
        "@id": {"$ref": "#/$defs/iri"},
        "@type": {"const": "DataService"},
        "title": {"$ref": "#/$defs/text"},
        "endpointURL": {"$ref": "#/$defs/iriObject"},
        "endpointDescription": {"$ref": "#/$defs/iriObject"},
        "servesDataset": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"$ref": "#/$defs/iriObject"}
        },
        "conformsTo": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["@id", "@type"],
            "properties": {
              "@id": {"$ref": "#/$defs/iri"},
              "@type": {"const": "dct:Standard"}
            }
          }
        }
      }
    }
  }
}
