{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.httk.org/dsp/2025-1/dcat-ap-catalogue.json",
  "title": "DCAT-AP minimal context-substituted catalogue",
  "type": "object",
  "required": ["@context", "@id", "@type"],
  "anyOf": [
    {"required": ["participantId", "dct:title", "dct:description", "dct:publisher", "dataset", "service"]},
    {"required": ["title", "description", "dct:publisher", "dcat:dataset", "dcat:service"]}
  ],
  "properties": {
    "@context": {"type": "object"},
    "@id": {"$ref": "#/$defs/iri"},
    "@type": {"const": "Catalog"},
    "participantId": {"$ref": "#/$defs/iri"},
    "dct:title": {"$ref": "#/$defs/text"},
    "dct:description": {"$ref": "#/$defs/text"},
    "title": {"$ref": "#/$defs/text"},
    "description": {"$ref": "#/$defs/text"},
    "dct:publisher": {"$ref": "#/$defs/publisher"},
    "dataset": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/dataset"}},
    "service": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/service"}},
    "dcat:dataset": {"type": "array", "minItems": 1},
    "dcat:service": {"type": "array", "minItems": 1}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "iri": {"type": "string", "format": "uri"},
    "iriObject": {
      "type": "object", "required": ["@id"],
      "properties": {"@id": {"$ref": "#/$defs/iri"}, "@type": {"type": "string"}}
    },
    "standard": {
      "type": "object", "required": ["@id", "@type"],
      "properties": {"@id": {"$ref": "#/$defs/iri"}, "@type": {"const": "dct:Standard"}}
    },
    "publisher": {
      "type": "object",
      "required": ["@id", "@type"],
      "properties": {
        "@id": {"$ref": "#/$defs/iri"},
        "@type": {"enum": ["Agent", "http://xmlns.com/foaf/0.1/Agent"]},
        "foaf:name": {"$ref": "#/$defs/text"},
        "http://xmlns.com/foaf/0.1/name": {"$ref": "#/$defs/text"}
      }
    },
    "distribution": {
      "type": "object",
      "required": [
        "@id", "@type", "format", "dct:format", "dcat:accessURL",
        "dcat:downloadURL", "dcat:mediaType", "accessService"
      ],
      "properties": {
        "@id": {"$ref": "#/$defs/iri"},
        "@type": {"const": "Distribution"},
        "format": {"$ref": "#/$defs/iri"},
        "dct:format": {"$ref": "#/$defs/iriObject"},
        "dcat:accessURL": {"$ref": "#/$defs/iriObject"},
        "dcat:downloadURL": {"$ref": "#/$defs/iriObject"},
        "dcat:mediaType": {"$ref": "#/$defs/iriObject"},
        "accessService": {"$ref": "#/$defs/service"},
        "dcat:byteSize": {
          "type": "object", "required": ["@value", "@type"],
          "properties": {
            "@value": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"},
            "@type": {"const": "http://www.w3.org/2001/XMLSchema#nonNegativeInteger"}
          }
        }
      }
    },
    "dataset": {
      "type": "object",
      "required": ["@id", "@type", "dct:title", "dct:description", "dct:publisher", "hasPolicy", "distribution"],
      "properties": {
        "@id": {"$ref": "#/$defs/iri"},
        "@type": {"const": "Dataset"},
        "dct:title": {"$ref": "#/$defs/text"},
        "dct:description": {"$ref": "#/$defs/text"},
        "dct:publisher": {"$ref": "#/$defs/publisher"},
        "hasPolicy": {"type": "array", "minItems": 1, "maxItems": 1},
        "distribution": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/distribution"}}
      }
    },
    "service": {
      "type": "object",
      "required": ["@id", "@type", "dct:title", "endpointURL", "dct:conformsTo", "dcat:servesDataset"],
      "properties": {
        "@id": {"$ref": "#/$defs/iri"},
        "@type": {"const": "DataService"},
        "dct:title": {"$ref": "#/$defs/text"},
        "endpointURL": {"$ref": "#/$defs/iri"},
        "dct:conformsTo": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/standard"}},
        "dcat:servesDataset": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/iriObject"}}
      }
    }
  }
}
