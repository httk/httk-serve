{
  "@context": {
    "@version": 1.1,
    "@protected": true,
    "dcat": "http://www.w3.org/ns/dcat#",
    "dct": "http://purl.org/dc/terms/",
    "foaf": "http://xmlns.com/foaf/0.1/",
    "odrl": "http://www.w3.org/ns/odrl/2/",
    "Catalog": "dcat:Catalog",
    "Dataset": "dcat:Dataset",
    "Distribution": "dcat:Distribution",
    "DataService": "dcat:DataService",
    "Agent": "foaf:Agent",
    "Offer": "odrl:Offer",
    "permission": "odrl:permission",
    "action": {"@id": "odrl:action", "@type": "@vocab"},
    "use": "odrl:use",
    "title": "dct:title",
    "description": "dct:description",
    "publisher": {"@id": "dct:publisher", "@type": "@id"},
    "dataset": {"@id": "dcat:dataset", "@container": "@set"},
    "accessURL": {"@id": "dcat:accessURL", "@type": "@id"},
    "accessService": {"@id": "dcat:accessService", "@type": "@id"},
    "endpointURL": {"@id": "dcat:endpointURL", "@type": "@id"},
    "endpointDescription": {"@id": "dcat:endpointDescription", "@type": "@id"},
    "servesDataset": {"@id": "dcat:servesDataset", "@type": "@id", "@container": "@set"},
    "conformsTo": {"@id": "dct:conformsTo", "@type": "@id", "@container": "@set"},
    "format": {"@id": "dct:format", "@type": "@id"}
  },
  "@id": "https://example.invalid/catalogue",
  "@type": "Catalog",
  "title": "Example catalogue",
  "description": "A minimal catalogue with public OPTIMADE access.",
  "dct:publisher": {
    "@id": "https://example.invalid/participants/provider",
    "@type": "Agent",
    "foaf:name": "Example Provider"
  },
  "dcat:dataset": [{
    "@id": "https://example.invalid/dataset",
    "@type": "Dataset",
    "title": "Example dataset",
    "description": "A minimal dataset fixture.",
    "dct:publisher": {"@id": "https://example.invalid/participants/provider"},
    "odrl:hasPolicy": [{
      "@id": "https://example.invalid/offers/use",
      "@type": "Offer",
      "permission": [{"action": "use"}]
    }],
    "dcat:distribution": [{
      "@id": "https://example.invalid/distribution",
      "@type": "Distribution",
      "format": {
        "@id": "http://publications.europa.eu/resource/authority/file-type/JSON_LD",
        "@type": "dct:MediaTypeOrExtent"
      },
      "accessURL": {"@id": "https://example.invalid/data.jsonld"},
      "accessService": {"@id": "https://example.invalid/service"}
    }]
  }],
  "dcat:service": [
    {
      "@id": "https://example.invalid/service",
      "@type": "DataService",
      "title": "Example DSP data service",
      "endpointURL": {"@id": "https://example.invalid/dsp/2025-1"}
    },
    {
      "@id": "https://example.invalid/services/optimade",
      "@type": "DataService",
      "title": "Public OPTIMADE API",
      "endpointURL": {"@id": "https://example.invalid/optimade/v1"},
      "servesDataset": [{"@id": "https://example.invalid/dataset"}],
      "conformsTo": [{
        "@id": "https://schemas.optimade.org/defs/v1.3/standards/optimade",
        "@type": "dct:Standard"
      }],
      "endpointDescription": {"@id": "https://www.optimade.org/specification/latest/"}
    }
  ]
}
